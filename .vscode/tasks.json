{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Mesen (Release)",
            "type": "shell",
            "command": "make",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ],
            "detail": "Builds the project using the makefile."
        },
        {
            "label": "Build Mesen (Debug)",
            "type": "shell",
            "command": "make",
            "args": [
                "DEBUG=1"
            ],
            "group": "build",
            "problemMatcher": [
                "$gcc"
            ],
            "detail": "Builds the project in Debug mode."
        },
        {
            "label": "Clean",
            "type": "shell",
            "command": "make",
            "args": [
                "clean"
            ],
            "group": "build",
            "problemMatcher": []
        }
    ]
}